# ==============================================================================
# INNOVATION VPS MANAGEMENT PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Backend API Configuration
PORT=5000
# NODE_ENV=production

# MySQL / MariaDB Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
# Opt-in `npm run test:realmysql`: mysql://user:password@host:port of a DISPOSABLE server only.
# Never the production server. The script creates and drops its own vps_it_* database.
# REAL_MYSQL_URL=
DB_USER=root
DB_PASSWORD=
DB_NAME=vps_management_db
# DB_SOCKET=/run/mysqld/mysqld.sock
# Managed MySQL (Aiven): download ca.pem from the service overview. On Render paste it into
# DB_SSL_CA or DB_SSL_CA_BASE64 (never commit it). DB_SSL=1 verifies the server certificate.
DB_SSL=
DB_SSL_CA=
DB_SSL_CA_BASE64=
DB_SSL_CA_FILE=
DB_CONNECT_TIMEOUT_MS=

# Redis Distributed Cache & Session Store (Optional - Fallbacks to in-memory)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Session Security & Tokens
SESSION_SECRET=vps_super_secure_key_change_in_production_9876543210
ALLOWED_ORIGIN=http://localhost:3000

# Remote SSH Deployment Configuration (Optional)
SSH_HOST=127.0.0.1
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=
REMOTE_TARGET_DIR=/var/www/vps.innovationwebworks.in

# Email SMTP Notification Dispatch (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@example.com
SMTP_PASS=your_app_password_here

# ==============================================================================
# PRODUCTION HARDENING (Phase 1)
# ==============================================================================

# Address the backend binds to. Empty = 127.0.0.1 (loopback, reverse proxy only).
# Example: HOST=127.0.0.1  (use 0.0.0.0 only if no reverse proxy is in front)
HOST=

# Public base URL of the portal (absolute http/https URL, trailing "/" stripped).
# REQUIRED in production (startup fails if missing/invalid). Used for installer,
# migration and telemetry URLs. Outside production, empty = http://127.0.0.1:<PORT>.
# In production it MUST use https (http fails startup): agents download the installer
# and the agent binary (InnovationVpsAgent.exe) and receive Agent_Keys through URLs
# built from this value, so plain http would expose them. http is fine outside production.
# Example: PORTAL_BASE_URL=https://portal.example.com
PORTAL_BASE_URL=

# Extra allowed CORS origins, comma-separated (the PORTAL_BASE_URL origin is always allowed).
# Exact origin match only (scheme + host + port, no path).
# Example: CORS_ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=

# Server-side translation via the official Cloud Translation API.
# Enabled only when TRANSLATE_ENABLED=1 AND TRANSLATE_API_KEY is non-empty.
TRANSLATE_ENABLED=
TRANSLATE_API_KEY=

# Comma-separated reverse proxy addresses (IPv4, IPv6 or CIDR, max 50).
# Empty = trust loopback only (127.0.0.1, ::1). Example: 10.0.0.0/8,203.0.113.5
# Must list the address of the host running the PHP relay (public/api_proxy.php),
# which sets X-Forwarded-For/X-Real-IP to its own REMOTE_ADDR. Same host as Node:
# 127.0.0.1 and ::1 (already covered by the empty default).
# Caveat: if the PHP host is behind Cloudflare or another proxy, REMOTE_ADDR is that
# proxy's address and all clients appear to come from it. This is not handled.
TRUSTED_PROXIES=

# Agent authentication mode: "warn" (accept missing keys, log) or "enforce" (reject).
# Empty = warn. Do not switch to enforce until readyForEnforce is true.
AGENT_AUTH_MODE=

# Production only: set to 1 to allow falling back to database.json when MySQL is
# unavailable. Any other non-empty value is ignored with a warning (fallback stays
# off). Outside production the fallback is always allowed. Leave empty in production.
ALLOW_JSON_FALLBACK=

# AES-256 key for managed passwords at rest: 64 hex chars or base64 of 32 bytes.
# REQUIRED in production (startup fails if missing/invalid). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rules (see README.md "Encryption key backup"):
#   - Keep copies in two separate secure places (password manager + offline copy).
#   - Never commit it and never store it in BACKUP_DIR (the database dump directory).
#   - Losing it makes every encrypted password unrecoverable.
#   - No key rotation in v1 (the enc:v1: format has no key id yet).
#   - Test a database restore together with the key before relying on backups.
PASSWORD_ENCRYPTION_KEY=

# Shared secret for the x-internal-secret automation header.
# Empty = that authentication path is disabled. No built-in fallback value.
INTERNAL_SECRET=

# Initial password for the default admin user. In production, if empty the
# default admin is NOT seeded (an error is logged). Set a strong one-time value.
SUPERADMIN_DEFAULT_PASS=

# Public endpoint rate limits. Each is RATE_LIMIT_<NAME>_MAX (requests) and
# RATE_LIMIT_<NAME>_WINDOW_SEC (seconds); positive integers, empty = default shown.
# Invalid values fail startup naming the variable.
# request-demo, per IP: 5 per 1 hour
RATE_LIMIT_REQUEST_DEMO_MAX=5
RATE_LIMIT_REQUEST_DEMO_WINDOW_SEC=3600
# verify-customer, per IP: 5 per 1 hour
RATE_LIMIT_VERIFY_CUSTOMER_MAX=5
RATE_LIMIT_VERIFY_CUSTOMER_WINDOW_SEC=3600
# verify-customer, per username+phone (hard limit, prevents account enumeration): 3 per 1 hour
RATE_LIMIT_VERIFY_CUSTOMER_IDENTIFIER_MAX=3
RATE_LIMIT_VERIFY_CUSTOMER_IDENTIFIER_WINDOW_SEC=3600
# public tickets, per IP: 10 per 1 hour
RATE_LIMIT_PUBLIC_TICKETS_MAX=10
RATE_LIMIT_PUBLIC_TICKETS_WINDOW_SEC=3600
# reset-password, per IP and per username: 5 per 15 minutes
RATE_LIMIT_RESET_PASSWORD_MAX=5
RATE_LIMIT_RESET_PASSWORD_WINDOW_SEC=900
# OTP verification, per username: 5 per 15 minutes
RATE_LIMIT_OTP_VERIFY_MAX=5
RATE_LIMIT_OTP_VERIFY_WINDOW_SEC=900
# 2FA validate-login, per preAuthToken: 5 per 15 minutes
RATE_LIMIT_VALIDATE_LOGIN_MAX=5
RATE_LIMIT_VALIDATE_LOGIN_WINDOW_SEC=900
# 2FA validate-login, per IP: 20 per 15 minutes
RATE_LIMIT_VALIDATE_LOGIN_IP_MAX=20
RATE_LIMIT_VALIDATE_LOGIN_IP_WINDOW_SEC=900
# Agent authentication failures, per IP: 30 per 5 minutes
RATE_LIMIT_AGENT_AUTH_FAIL_MAX=30
RATE_LIMIT_AGENT_AUTH_FAIL_WINDOW_SEC=300

# Optional: absolute path of the JSON fallback store. Empty uses <repo>/database.json (tests set a temp path).
DB_FILE_PATH=
