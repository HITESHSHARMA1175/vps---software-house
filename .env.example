# ==============================================================================
# INNOVATION VPS MANAGEMENT PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Backend API Configuration
PORT=5000
# NODE_ENV=production

# MySQL / MariaDB Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vps_management_db
# DB_SOCKET=/run/mysqld/mysqld.sock

# Redis Distributed Cache & Session Store (Optional - Fallbacks to in-memory)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Session Security & Tokens
SESSION_SECRET=vps_super_secure_key_change_in_production_9876543210
ALLOWED_ORIGIN=http://localhost:3000

# Remote SSH Deployment Configuration (Optional)
SSH_HOST=127.0.0.1
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=
REMOTE_TARGET_DIR=/var/www/vps.innovationwebworks.in

# Email SMTP Notification Dispatch (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@example.com
SMTP_PASS=your_app_password_here
